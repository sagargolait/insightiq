APP_ENV=development
APP_PORT=8080
# API connects as the RLS-restricted role (see `make db-app-role`), never the
# schema owner. Migrations use the owner credentials in the Makefile.
DATABASE_URL=postgres://insightiq_app:local_app_password@localhost:5432/insightiq?sslmode=disable
# Integration tests (go test ./...) run against this; unset = skipped.
TEST_DATABASE_URL=postgres://insightiq_app:local_app_password@localhost:5432/insightiq?sslmode=disable
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3000
# Data-source credential encryption (AES-256-GCM). Keys are versioned so they
# can be rotated: DATA_ENCRYPTION_KEYS holds one or more <version>:<base64-32B>
# entries, and DATA_ENCRYPTION_ACTIVE_KEY_VERSION picks the one used to seal new
# credentials. Generate a key with: openssl rand -base64 32
DATA_ENCRYPTION_KEYS=v1:OEOBj2ALH2xuK+DFB/eEwU9KEQUu34CyuW7M11Mlsok=
DATA_ENCRYPTION_ACTIVE_KEY_VERSION=v1
